FROM docker.io/library/maven:3-eclipse-temurin-25 AS build
WORKDIR /w
COPY pom.xml .
# resolve dependencies in their own layer so source edits do not re-download them
RUN mvn -q -B dependency:go-offline
COPY src src
RUN mvn -q -B package -DskipTests

FROM docker.io/library/eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /w/target/client.jar /app/client.jar
ENV CA_URL=http://ca.demo:8080 \
    API_URL=https://api.demo:8443
USER 65534:65534
CMD ["java","-jar","/app/client.jar"]
